#!/bin/sh
# tmag for agents, shipped by the tmag-peers plugin: runs the tmag binary this
# agent's hooks run. Generated by internal/binpath; do not edit.
for r in "${TMUX_PLUGIN_MANAGER_PATH%/}" "$HOME/.tmux/plugins" "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins"; do case $r in /*) t="$r/tmux-agent-experience/bin/tmag"; [ -x "$t" ] && exec "$t" "$@";; esac; done;
self=$(cd "${0%/*}" && pwd -P)
set -f; IFS=:
for d in $PATH; do case $d in /*) t="$d/tmag"; [ -x "$t" ] && [ "$(cd "$d" && pwd -P)" != "$self" ] && exec "$t" "$@";; esac; done
case $1 in hook|answer-hook) exit 0;; esac
echo "tmag: not installed; install the tmux plugin: https://github.com/ChrAlpha/tmux-agent-experience#install" >&2
exit 127
