{
  "name": "tmag-client",
  "version": "0.1.0",
  "private": true,
  "description": "A page for your phone that works with the coding agents tmag knows on a computer at home",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome ci . && tsc --noEmit && vitest run",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "eventsource-parser": "^4.1.3",
    "markdown-it": "^15.0.3",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
